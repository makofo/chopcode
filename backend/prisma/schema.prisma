generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // при таком объёме пользователей SQLite не подойдёт
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  telegramId    String    @unique
  firstName     String?
  username      String?
  voiceToken    String?   @unique // личный токен для iOS Shortcut / Back Tap, не общий секрет
  freeVoiceUsed   Int       @default(0) // сколько из 2 бесплатных голосовых уже использовано
  subscriptionUntil DateTime? // null = нет активной подписки (кроме lifetime)
  isLifetime      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  reminders     Reminder[]
  transactions  Transaction[]
  meals         Meal[]
  diaryEntries  DiaryEntry[]
  profile       Profile?
}

model Profile {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int      @unique
  gender       String
  age          Int
  heightCm     Float
  weightKg     Float
  activity     String
  goal         String
  updatedAt    DateTime @updatedAt
}

model Reminder {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  text      String
  dueAt     DateTime
  repeat    String?
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isDone, dueAt]) // именно по этой паре идёт запрос в cron каждую минуту
  @@index([userId])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  amount    Float
  category  String
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Meal {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  name      String
  calories  Float
  protein   Float
  fat       Float
  carbs     Float
  eatenAt   DateTime @default(now())

  @@index([userId, eatenAt])
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  text      String
  mood      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
