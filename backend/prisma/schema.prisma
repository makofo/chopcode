generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // SQLite would not scale for this many users
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  telegramId    String    @unique
  firstName     String?
  username      String?
  voiceToken    String?   @unique // personal token for iOS Shortcut / Back Tap, not a shared secret
  freeVoiceUsed   Int       @default(0) // how many of the 2 free voice notes were used
  subscriptionUntil DateTime? // null = no active subscription (except lifetime)
  isLifetime      Boolean   @default(false)
  streakCount     Int       @default(0) // consecutive days with at least one meal logged
  streakLastDay   String?              // last logged day as "YYYY-MM-DD" in Moscow time
  createdAt     DateTime  @default(now())

  reminders     Reminder[]
  transactions  Transaction[]
  meals         Meal[]
  diaryEntries  DiaryEntry[]
  profile       Profile?
}

model Profile {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int      @unique
  gender       String
  age          Int
  heightCm     Float
  weightKg     Float
  activity     String
  goal         String
  updatedAt    DateTime @updatedAt
}

model Reminder {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  text        String
  dueAt       DateTime
  repeat      String?
  isDone      Boolean  @default(false)
  preNotified Boolean  @default(false) // true once the "1 hour before" nudge was sent
  createdAt   DateTime @default(now())

  @@index([isDone, dueAt]) // the per-minute cron queries by this pair
  @@index([userId])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  amount    Float
  category  String
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Meal {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  name      String
  calories  Float
  protein   Float
  fat       Float
  carbs     Float
  eatenAt   DateTime @default(now())

  @@index([userId, eatenAt])
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  text      String
  mood      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
