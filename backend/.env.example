BOT_TOKEN=123456:your-telegram-bot-token
DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=3000
WEBAPP_URL=https://your-frontend-domain.example

# Публичный HTTPS-адрес ЭТОГО backend'а (нужен, чтобы Telegram знал, куда слать webhook)
PUBLIC_URL=https://your-backend-domain.example

# Распознавание речи (Whisper API от OpenAI)
OPENAI_API_KEY=sk-...

# ИИ-классификация голосовых записей по вкладкам (Claude API от Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
